model Municipality {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // official PGIS code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barangays Barangay[]

  @@index([code])
}

model Barangay {
  id             String       @id @default(uuid())
  name           String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  municipalityId String
  officialCode   String       @unique // official PGIS code
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Project        Project[]

  @@unique([name, municipalityId])
  @@index([officialCode])
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model Project {
  id                 String             @id @default(uuid())
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  projectCode        String?            @unique
  title              String
  startDate          String // year only
  endDate            String? // year only
  totalAreaDeveloped Float? // in hectares
  status             ProjectStatus      @default(PLANNED)
  description        String?
  totalProjectCost   Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  barangay           Barangay           @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  barangayId         String
  // relations
  components         ProjectComponent[]
  attachments        Attachment[]

  @@index([status])
  @@index([startDate])
}

model Component {
  id             String   @id @default(uuid())
  componentTitle String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProjectComponent {
  id                   String   @id @default(uuid())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  componentTitle       String
  componentDescription String?
  componentCost        Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
}

model Attachment {
  id         String   @id @default(uuid())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String?
  url        String // storage path (Supabase bucket URL or signed URL)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([projectId])
}
